# Fill this in, save it as .env (in the same folder), then run:  npm run env
# .env stays on your computer and is never uploaded to the site, the browser or git.

# From @BotFather
BOT_TOKEN=
# Bot name without @
BOT_USERNAME=
# Your Telegram user id (from @userinfobot); comma-separated for several admins
ADMIN_IDS=
# Free key from https://api.nasa.gov
NASA_API_KEY=
PRO_PRICE_STARS=150
DIGEST_HOUR_UTC=5

# Only for the own-server version (Railway / Oracle):
# PUBLIC_URL=https://your-domain
# DB_PATH=/data/event_horizon.db
